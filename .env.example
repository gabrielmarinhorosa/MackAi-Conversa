# Copie para .env e preencha. Nunca faça commit do .env.
DATABASE_URL=postgresql://mackai:mackai@localhost:5432/conversas_db
ORQUESTRADOR_URL=http://localhost:8001
ORQUESTRADOR_TIMEOUT_S=60

# Módulo 1. Sem estas linhas, o serviço usa os endereços publicados do Módulo 1.
# Para desenvolver com o Módulo 1 falso (uvicorn dev.modulo1_falso:app --port 8002):
MOD1_AUTH_URL=http://localhost:8002
MOD1_PROJECTS_URL=http://localhost:8002
MOD1_JWT_ISSUER=mod1-auth-local
MOD1_CACHE_S=60

CHAT_LIMIT_PER_USER=10
CHAT_LIMIT_GLOBAL=60
MAX_MESSAGE_CHARS=20000
# Origens exatas dos fronts de outros módulos que chamam esta API pelo navegador, separadas por vírgula.
CORS_ORIGINS=
