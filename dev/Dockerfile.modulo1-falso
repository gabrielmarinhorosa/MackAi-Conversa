FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.163.0 uvicorn==0.54.0 "PyJWT[crypto]==2.15.1"
COPY modulo1_falso.py dev/modulo1_falso.py
RUN touch dev/__init__.py
EXPOSE 8000
CMD ["uvicorn", "dev.modulo1_falso:app", "--host", "0.0.0.0", "--port", "8000"]
