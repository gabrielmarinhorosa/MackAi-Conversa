FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.163.0 uvicorn==0.54.0
COPY orquestrador_falso.py dev/orquestrador_falso.py
RUN touch dev/__init__.py
EXPOSE 8000
CMD ["uvicorn", "dev.orquestrador_falso:app", "--host", "0.0.0.0", "--port", "8000"]
