{
  "info": {
    "_postman_id": "6f1d8a7e-3c2b-4e59-9a0d-5b7c1e2f4a60",
    "name": "mackai-conversas",
    "description": "API pública do mackai-conversas (Módulo 7). O pre-request da coleção obtém um token em POST /api/sessions e guarda em {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Obtém um token anônimo uma vez e reaproveita nas outras requisições.",
          "if (pm.request.url.getPath() === '/api/sessions' || pm.collectionVariables.get('token')) return;",
          "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/sessions', method: 'POST' }, (err, res) => {",
          "  if (err) { console.error(err); return; }",
          "  pm.collectionVariables.set('token', res.json().token);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sessões",
      "item": [
        {
          "name": "Criar sessão",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"token e expires_at\", () => pm.expect(body).to.have.keys(\"token\", \"expires_at\"));",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ]
        }
      ]
    },
