{
  "info": {
    "_postman_id": "6f1d8a7e-3c2b-4e59-9a0d-5b7c1e2f4a60",
    "name": "mackai-conversas",
    "description": "API pública do mackai-conversas (Módulo 7). O pre-request da coleção faz login no Módulo 1 (POST {{mod1AuthUrl}}/auth/token com {{email}} e {{password}} do ambiente) e guarda o access_token em {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Faz login no Módulo 1 uma vez e reaproveita o token nas outras requisições.",
          "if (pm.request.url.getPath() === '/auth/token' || pm.collectionVariables.get('token')) return;",
          "pm.sendRequest({",
          "  url: pm.variables.get('mod1AuthUrl') + '/auth/token', method: 'POST',",
          "  header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "  body: { mode: 'urlencoded', urlencoded: [",
          "    { key: 'username', value: pm.variables.get('email') },",
          "    { key: 'password', value: pm.variables.get('password') },",
          "  ] },",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) { console.error('login no Módulo 1 falhou', err || res.code); return; }",
          "  pm.collectionVariables.set('token', res.json().access_token);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Módulo 1",
      "item": [
        {
          "name": "Login (POST /auth/token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{mod1AuthUrl}}/auth/token",
              "host": [
                "{{mod1AuthUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"access_token\", () => pm.expect(body).to.include.keys(\"access_token\"));",
                  "pm.collectionVariables.set(\"token\", body.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
